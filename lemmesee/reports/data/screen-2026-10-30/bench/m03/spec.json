 "stories": [
  {"id": "denials-climb", "says": "From late in the period, a much larger share of reimbursement claims ends in denial, while the paid share falls.", "table": "Reimbursements", "from_day": 66, "change": {"column": "ReimbursementStatus", "values": {"Denied": 30, "Paid": 25, "Pending benefits": 8, "Approved": 6, "Pending supervisor": 3, "Pending department head": 2, "Submitted": 2}}, "seen_in": [{"table": "Reimbursements", "column": "ReimbursementStatus"}, {"table": "Reimbursements", "column": "DateSubmitted"}]},
  {"id": "paid-awards-jump", "says": "The amount awarded on each paid claim nearly doubles in the last weeks, so the money paid out grows faster than the number of claims.", "table": "Reimbursements", "from_day": 72, "change": {"column": "AmountAwarded", "times": 1.8, "where": {"ReimbursementStatus": "Paid"}}, "seen_in": [{"table": "Reimbursements", "column": "AmountAwarded"}, {"table": "Reimbursements", "column": "ReimbursementStatus"}, {"table": "Reimbursements", "column": "DateSubmitted"}]},
  {"id": "certifications-take-over", "says": "Certification courses make up most of the events starting in the last weeks, pushing conferences and workshops aside.", "table": "Events", "from_day": 70, "change": {"column": "EventType", "values": {"Certification": 6, "Course": 2, "Conference": 1, "Workshop": 1}}, "seen_in": [{"table": "Events", "column": "EventType"}, {"table": "Events", "column": "StartDate"}]}
 ],
