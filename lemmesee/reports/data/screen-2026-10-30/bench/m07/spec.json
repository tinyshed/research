  "stories": [
    {
      "id": "no-shows-rise",
      "says": "From 12 October about one reservation in five ends as a no-show, up from one in twenty, so rooms sold for those nights sit empty.",
      "table": "Reservation",
      "from_day": 72,
      "change": {"column": "status", "values": {"confirmed": 0.45, "checked-out": 0.3, "no-show": 0.2, "cancelled": 0.05}},
      "seen_in": [
        {"table": "Reservation", "column": "status"},
        {"table": "Reservation", "column": "resvDate"}
      ]
    },
    {
      "id": "room-rates-up",
      "says": "From 16 October room rates rise by about a third, so each checkout totals about a third more.",
      "table": "CheckOut",
      "from_day": 76,
      "change": {"column": "totalPrice", "times": 1.35, "where": null},
      "seen_in": [
        {"table": "CheckOut", "column": "totalPrice"},
        {"table": "CheckOut", "column": "date"}
      ]
    }
  ],
  "decoys": [
    {
      "id": "reservation-detail-repeats-reservations",
      "says": "ReservationDetail has one row per room of each reservation, made a minute after it, so counting it beside Reservation counts the same stays twice.",
