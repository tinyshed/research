@@ -0,0 +1,46 @@
+use serde_json::json;
+
+use super::*;
+use crate::records::event::Fields;
+
+fn event(message: &str, fields: serde_json::Value) -> Kept {
+    Kept {
+        at: 0,
+        id: None,
+        name: "Request".to_owned(),
+        level: None,
+        message: Some(message.to_owned()),
+        fields: Fields::of(&fields).unwrap(),
+        context: Fields::of(&json!({ "host": "web-7" })).unwrap(),
+        trace_id: None,
+        span_id: None,
+    }
+}
+
+// contract: REC-12
+#[test]
+fn every_text_a_search_reads_lets_its_block_pass_and_most_others_do_not() {
+    let events = [
+        event("Connection reset by peer", json!({ "path": "/api/Users/128", "tags": ["Ünïcode", { "deep": "blk_42" }] })),
+        event("cache hit", json!({ "status": 200, "ok": true })),
+    ];
+    let filter = grams_of(&events);
+    // in the case a search reads: messages, names, values at any depth, numbers as written
+    for found in ["connection reset", "reset by", "request", "/api/users/1", "ünïcode", "blk_42", "web-7", "200", "true"] {
+        assert!(may_hold(&filter, found), "{found}");
+        assert!(events.iter().any(|event| super::super::read::texts(event, &mut |text| text.contains(found))));
+    }
+    // a key is not a text, and what is shorter than a trigram passes every block
+    assert!(may_hold(&filter, "ok") && may_hold(&filter, ""));
+    let missing = ["econnrefused", "timeout while", "blk_-1608999687919862906", "path", "deep"];
+    assert!(missing.iter().filter(|text| may_hold(&filter, text)).count() <= 1, "two bits a trigram");
+}
+
+#[test]
+fn a_filter_of_another_version_or_none_passes_every_search() {
+    assert!(may_hold(&[], "anything"));
+    assert!(may_hold(&[2, 0, 0], "anything"));
+    assert!(may_hold(&[VERSION], "anything"));
+    let filter = grams_of(&[event("x", json!({}))]);
+    assert_eq!(filter.len(), 1 + FEWEST_BITS / 8, "a block of few trigrams keeps the fewest bits");
+}
