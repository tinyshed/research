diff --git a/crates/tinystore/src/records/grams.rs b/crates/tinystore/src/records/grams.rs
new file mode 100644
index 00000000..67082a03
--- /dev/null
+++ b/crates/tinystore/src/records/grams.rs
@@ -0,0 +1,71 @@
+//! A block's trigrams, by which a search passes a block that cannot hold its
+//! text: every three bytes of each text a search reads, in the case it reads
+//! them, set in a bitmap of two bits a distinct trigram. Each of a search's
+//! own trigrams must be set, or no event of the block holds it; a text
+//! shorter than three bytes passes every block.
+//!
+//! ```text
+//! filter = 1 | bits, the lowest of each byte first
+//! ```
+//!
+//! Two bits a trigram leave about four in ten set, and a search passes a
+//! block without its text only where every one of its trigrams is: about
+//! once in sixteen for `error`'s three, once in 1,700 for `econnreset`'s
+//! eight, and next to never for the twenty-two of an HDFS block id. LogHub's
+//! blocks hold 1,100 to 5,400 trigrams, a filter of 1 to 10 % of their bytes
+//! under zlib.
+
+use std::collections::HashSet;
+
+use super::event::Kept;
+use super::read::texts;
+
+const VERSION: u8 = 1;
+const BITS_A_GRAM: usize = 2;
+const FEWEST_BITS: usize = 64;
+
+/// The filter of the texts `events` hold.
+pub(super) fn grams_of(events: &[Kept]) -> Vec<u8> {
+    let mut grams: HashSet<u32> = HashSet::new();
+    for event in events {
+        texts(event, &mut |text| {
+            grams.extend(text.as_bytes().windows(3).map(gram));
+            false
+        });
+    }
+    let bits = (grams.len() * BITS_A_GRAM).max(FEWEST_BITS).next_multiple_of(8);
+    let mut filter = vec![0_u8; 1 + bits / 8];
+    filter[0] = VERSION;
+    for gram in grams {
+        let bit = place(gram, bits);
+        filter[1 + bit / 8] |= 1 << (bit % 8);
+    }
+    filter
+}
+
+/// Whether a block of `filter` may hold `text`, which is in lower case. One
+/// of another version passes, as one the store cannot read must.
+pub(super) fn may_hold(filter: &[u8], text: &str) -> bool {
+    let Some((&VERSION, bitmap)) = filter.split_first() else { return true };
+    let bits = bitmap.len() * 8;
+    bits == 0
+        || text.as_bytes().windows(3).all(|window| {
+            let bit = place(gram(window), bits);
+            bitmap[bit / 8] & (1 << (bit % 8)) != 0
+        })
+}
+
+fn gram(window: &[u8]) -> u32 {
+    u32::from(window[0]) << 16 | u32::from(window[1]) << 8 | u32::from(window[2])
+}
+
+/// A trigram's bit among `bits`: its multiplicative hash's high half scaled to
+/// them, which takes no division.
+fn place(gram: u32, bits: usize) -> usize {
+    let hashed = u64::from(gram).wrapping_mul(0x9e37_79b9_7f4a_7c15) >> 32;
+    ((hashed * bits as u64) >> 32) as usize
+}
+
+#[cfg(test)]
+#[path = "grams_tests.rs"]
+mod tests;
diff --git a/crates/tinystore/src/records/grams_tests.rs b/crates/tinystore/src/records/grams_tests.rs
new file mode 100644
